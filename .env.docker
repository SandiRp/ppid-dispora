APP_NAME="PPID Dispora Jatim"
APP_ENV=production
# Biarkan APP_KEY kosong untuk digenerate otomatis saat startup, atau isi base64:... secara manual
APP_KEY=
APP_DEBUG=false
# Untuk deployment produksi dengan domain HTTPS, ganti menjadi https://ppid.dispora.jatimprov.go.id
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ppid_dispora_db
DB_USERNAME=root
DB_PASSWORD=root_ppid_2026

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Konfigurasi Notifikasi Email SMTP Gmail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=disporajatim2024@gmail.com
# Isi dengan Google App Password sebelum menjalankan di produksi
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="disporajatim2024@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
PPID_ADMIN_EMAIL=disporajatim2024@gmail.com

# Opsional: Gateway WhatsApp (Fonnte)
FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
